{
  "expo": {
    "name": "FG Mobile",
    "slug": "fg-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/mobile_icom.png",
    "scheme": "fgmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foundergroundworks.fgmobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#192B47",
        "foregroundImage": "./assets/logos/mobile_icom.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.foundergroundworks.fgmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/logos/mobile_icom.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logos/FounderGroundworksLogoBlueBG.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#192B47"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e913cc53-66f0-4eb0-992f-c60107bef9d8"
      }
    },
    "owner": "steppa"
  }
}
